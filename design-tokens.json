{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "School Local Platform Design Tokens",
  "version": "1.1.0",
  "color": {
    "light": {
      "surface": {
        "default": "#F8FAFC",
        "raised": "#FFFFFF",
        "sunken": "#F1F5F9"
      },
      "text": {
        "primary": "#0F172A",
        "secondary": "#475569",
        "tertiary": "#94A3B8"
      },
      "border": {
        "default": "#E2E8F0",
        "strong": "#CBD5E1"
      },
      "action": {
        "primary": "#4F46E5",
        "hover": "#4338CA",
        "pressed": "#3730A3",
        "subtle": "#E0E7FF",
        "onAction": "#FFFFFF"
      },
      "semantic": {
        "success": "#16A34A",
        "successSubtle": "#DCFCE7",
        "warning": "#D97706",
        "warningSubtle": "#FEF3C7",
        "error": "#DC2626",
        "errorSubtle": "#FEE2E2",
        "info": "#2563EB",
        "infoSubtle": "#DBEAFE"
      }
    },
    "dark": {
      "surface": {
        "default": "#0F1117",
        "raised": "#1A1D27",
        "sunken": "#080A0F"
      },
      "text": {
        "primary": "#F1F5F9",
        "secondary": "#94A3B8",
        "tertiary": "#64748B"
      },
      "border": {
        "default": "#2D3142",
        "strong": "#41465A"
      },
      "action": {
        "primary": "#A5B4FC",
        "hover": "#C7D2FE",
        "pressed": "#818CF8",
        "subtle": "#293653",
        "onAction": "#111827"
      },
      "semantic": {
        "success": "#4ADE80",
        "successSubtle": "#143D2B",
        "warning": "#FBBF24",
        "warningSubtle": "#493816",
        "error": "#F87171",
        "errorSubtle": "#4B2228",
        "info": "#60A5FA",
        "infoSubtle": "#1D3556"
      }
    }
  },
  "typography": {
    "sans": "Inter, Geist, system-ui, sans-serif",
    "mono": "JetBrains Mono, Geist Mono, ui-monospace, monospace",
    "display": {
      "size": 32,
      "lineHeight": 40
    },
    "h1": {
      "size": 24,
      "lineHeight": 32
    },
    "h2": {
      "size": 20,
      "lineHeight": 28
    },
    "bodyDesktop": {
      "size": 14,
      "lineHeight": 21
    },
    "bodyMobile": {
      "size": 16,
      "lineHeight": 24
    },
    "small": {
      "size": 12,
      "lineHeight": 18
    },
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    },
    "letterSpacing": {
      "label": "0.06em",
      "overline": "0.08em"
    }
  },
  "spacing": {
    "base": 4,
    "scale": [
      4,
      8,
      12,
      16,
      20,
      24,
      32,
      40,
      48,
      64
    ]
  },
  "radius": {
    "sm": 4,
    "md": 6,
    "lg": 8,
    "xl": 12,
    "circle": "50%",
    "activeIndicator": "0 4px 4px 0"
  },
  "shadows": {
    "sm": "0 1px 2px rgba(15,23,42,0.06)",
    "md": "0 2px 4px rgba(15,23,42,0.08)",
    "lg": "0 4px 8px rgba(15,23,42,0.10)"
  },
  "layout": {
    "desktop": {
      "sidebarWidth": 264,
      "sidebarCollapsed": 72,
      "headerHeight": 60,
      "tableRowHeight": [
        40,
        44
      ],
      "statusBarHeight": 44
    },
    "mobile": {
      "bottomTabs": [
        4,
        5
      ],
      "minimumTouchTarget": 44
    },
    "shell": {
      "sidebarBrandHeight": 76,
      "sidebarFooterHeight": 68,
      "controlHeight": 44,
      "brandMarkSize": 40,
      "avatarSize": 40,
      "navIconSize": 24,
      "navIndicatorWidth": 4,
      "indicatorDotSize": 8,
      "navCountMinWidth": 24,
      "navCountHeight": 24,
      "collapsedNavItemSize": 48,
      "topbarSearchMaxWidth": 440,
      "userLabelMaxWidth": 200,
      "statusLabelMaxWidth": 132,
      "statusPopoverMaxWidth": 320,
      "commandDialogMaxWidth": 640,
      "commandDialogMaxHeight": 720,
      "commandInputHeight": 56,
      "commandEmptyHeight": 72,
      "pageContentMaxWidth": 1600
    }
  },
  "accessibility": {
    "focusRing": "2px solid color.action.primary",
    "focusOffset": 2,
    "reducedMotion": "Respect prefers-reduced-motion and user preference",
    "minimumInteractiveTarget": 44,
    "focusWidth": "2px"
  },
  "motion": {
    "fast": "150ms ease",
    "reduced": "0.01ms"
  }
}
